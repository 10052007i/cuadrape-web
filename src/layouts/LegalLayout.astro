---
import BaseLayout from './BaseLayout.astro';
import Contenedor from '../components/ui/Contenedor.astro';

interface Props {
  titulo: string;
  actualizado: Date;
}

const { titulo, actualizado } = Astro.props;

const fechaFormateada = new Intl.DateTimeFormat('es-PE', {
  dateStyle: 'long',
}).format(actualizado);
---

<BaseLayout titulo={`${titulo} | Cuadrape`} descripcion={`Página legal de ${titulo} de Cuadrape.`}>
  <article class="py-12 md:py-16">
    <Contenedor class="max-w-prose">
      <header class="mb-8 border-b border-[var(--color-borde)] pb-6">
        <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--color-marca)] mb-2">
          {titulo}
        </h1>
        <p class="text-sm text-[var(--color-tinta-suave)]">
          Última actualización: {fechaFormateada}
        </p>
      </header>
      <div class="prose prose-slate max-w-none text-base leading-relaxed space-y-6">
        <slot />
      </div>
    </Contenedor>
  </article>
</BaseLayout>
