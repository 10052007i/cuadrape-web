---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  width,
  height,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  class:list={['w-full h-auto object-cover rounded-lg', className]}
  loading={loading}
  fetchpriority={fetchpriority}
  width={width}
  height={height}
/>
