---
interface Props {
  href?: string;
  variante?: 'primario' | 'secundario' | 'whatsapp' | 'subtil';
  anchoCompleto?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  variante = 'primario',
  anchoCompleto = true,
  class: className = '',
  target,
  rel,
} = Astro.props;

const baseClases =
  'inline-flex items-center justify-center font-semibold text-center rounded-[6px] h-[52px] md:h-[56px] px-6 transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-marca)] cursor-pointer text-[17px] leading-none shadow-xs hover:shadow-md';

const variantes = {
  primario:
    'bg-[#023F72] text-white hover:bg-[#0E2439] active:bg-[#01223E]',
  secundario:
    'bg-[#F2F5F8] text-[#0E2439] border border-[#D3DCE5] hover:bg-[#E2E8F0]',
  whatsapp:
    'bg-[#25D366] text-white hover:bg-[#1EBE5D] active:bg-[#15A04D]',
  subtil:
    'bg-transparent text-[#0E2439] hover:text-[#023F72] px-2 py-3 h-auto font-semibold text-[16px] shadow-none hover:shadow-none',
};

const anchoClases = anchoCompleto ? 'w-full md:w-auto' : 'w-auto';
const Elemento = href ? 'a' : 'button';
---

<Elemento
  href={href}
  target={target}
  rel={rel}
  class:list={[baseClases, variantes[variante], anchoClases, className]}
>
  <slot />
</Elemento>
