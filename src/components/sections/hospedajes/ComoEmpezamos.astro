---
import Seccion from '../../ui/Seccion.astro';
import Contenedor from '../../ui/Contenedor.astro';
import { pasosHospedajes } from '../../../data/hospedajes/pasos';
---

<Seccion id="como-empezamos" fondo="blanco">
  <Contenedor>
    <div class="max-w-3xl mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-marca)] mb-3">
        Cómo empezamos
      </h2>
      <p class="text-base text-[var(--color-tinta-suave)]">
        Poner a funcionar Cuadrape en tu hospedaje toma pocos días y no interrumpe tu atención.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {pasosHospedajes.map((paso) => (
        <div class="bg-[var(--color-superficie)] p-6 rounded-2xl border border-[var(--color-borde)] relative">
          <span class="w-10 h-10 rounded-full bg-[var(--color-marca)] text-white font-extrabold text-lg flex items-center justify-center mb-4">
            {paso.numero}
          </span>
          <h3 class="text-lg font-bold text-[var(--color-tinta)] mb-2">
            {paso.titulo}
          </h3>
          <p class="text-sm text-[var(--color-tinta-suave)] leading-relaxed">
            {paso.descripcion}
          </p>
        </div>
      ))}
    </div>
  </Contenedor>
</Seccion>
