---
import { getCollection } from 'astro:content';
import Seccion from '../../ui/Seccion.astro';
import Contenedor from '../../ui/Contenedor.astro';

const resultadosRaw = await getCollection('resultados');
const resultadosPublicados = resultadosRaw.filter((r) => r.data.publicado && r.data.producto === 'hospedajes');
const resultado = resultadosPublicados[0]?.data;
---

{resultado && (
  <Seccion id="resultados" fondo="blanco">
    <Contenedor>
      <div class="max-w-3xl mb-10">
        <span class="inline-block bg-[var(--color-superficie)] text-[var(--color-marca)] text-xs font-bold px-3 py-1 rounded-full border border-[var(--color-borde)] mb-3">
          Prueba Real en Piloto
        </span>
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-marca)] mb-3">
          Resultados en el primer mes
        </h2>
        <p class="text-base text-[var(--color-tinta-suave)]">
          {resultado.contexto}
        </p>
      </div>

      <!-- 3 Cifras -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {resultado.cifras.map((cifra) => (
          <div class="bg-[var(--color-superficie)] p-6 rounded-2xl border border-[var(--color-borde)] text-center">
            <span class="block text-4xl md:text-5xl font-extrabold text-[var(--color-marca)] tabular-nums mb-2">
              {cifra.valor}
            </span>
            <span class="text-sm font-semibold text-[var(--color-tinta-suave)]">
              {cifra.etiqueta}
            </span>
          </div>
        ))}
      </div>

      <!-- Cita -->
      {resultado.cita && (
        <div class="bg-amber-50 border border-amber-200 p-6 md:p-8 rounded-2xl">
          <blockquote class="text-base md:text-lg italic text-amber-900 leading-relaxed">
            "{resultado.cita}"
          </blockquote>
        </div>
      )}
    </Contenedor>
  </Seccion>
)}
