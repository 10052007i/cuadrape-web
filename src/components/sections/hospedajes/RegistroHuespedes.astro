---
import Seccion from '../../ui/Seccion.astro';
import Contenedor from '../../ui/Contenedor.astro';
---

<Seccion id="registro-huespedes" fondo="blanco">
  <Contenedor>
    <div class="max-w-3xl space-y-4">
      <span class="inline-block bg-[var(--color-superficie)] text-[var(--color-marca)] text-xs font-bold px-3 py-1 rounded-full border border-[var(--color-borde)]">
        Tranquilidad Legal
      </span>
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-marca)]">
        Registro rápido de huéspedes y control de menores
      </h2>
      <p class="text-base md:text-lg text-[var(--color-tinta)] leading-relaxed">
        Registra el tipo y número de documento de los ocupantes en segundos. El sistema alerta si un dato falta o si se intenta ingresar a un menor sin la documentación correspondiente.
      </p>
      <p class="text-sm text-[var(--color-tinta-suave)]">
        Tus datos se almacenan de forma aislada e independizada para cada hospedaje, sin guardar fotografías innecesarias de documentos.
      </p>
    </div>
  </Contenedor>
</Seccion>
