---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contenedor from '../components/ui/Contenedor.astro';
import Boton from '../components/ui/Boton.astro';
---

<BaseLayout titulo="Página no encontrada | Cuadrape" descripcion="La página solicitada no existe o ha sido movida.">
  <div class="py-20 md:py-32 text-center">
    <Contenedor class="max-w-md">
      <h1 class="text-6xl md:text-8xl font-extrabold text-[var(--color-marca)] mb-4 tabular-nums">
        404
      </h1>
      <h2 class="text-2xl font-bold text-[var(--color-tinta)] mb-3">
        Página no encontrada
      </h2>
      <p class="text-base text-[var(--color-tinta-suave)] mb-8">
        La dirección que ingresaste no existe o cambió de lugar.
      </p>
      <Boton href="/" variante="primario" anchoCompleto={false}>
        Volver a la página principal
      </Boton>
    </Contenedor>
  </div>
</BaseLayout>
